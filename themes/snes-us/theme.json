{
  "api": 1,
  "id": "snes-us",
  "name": "SNES (US)",
  "version": "1.2.0",
  "author": "romforge",
  "licence": "CC0-1.0 AND OFL-1.1",
  "licence_url": "https://openfontlicense.org/open-font-license-official-text/",
  "description": "The North American Super NES: a grey shell, purple and lavender buttons, rounded corners; or a night scheme. Pixelify Sans type (OFL; its licence heads theme.css).",
  "layout": "grid",
  "layouts": [
    "list",
    "cover-flow",
    "wheel",
    "shelves",
    "hero",
    "hero-bottom",
    "bookshelf"
  ],
  "fallback": "title",
  "schemes": {
    "usa": {
      "--fs-bg": "#c4bfd8",
      "--fs-bg-2": "#dedaee",
      "--fs-panel": "#ece9f6",
      "--fs-text": "#25223a",
      "--fs-muted": "#4a4560",
      "--fs-accent": "#4b3fa8",
      "--fs-accent-text": "#ffffff",
      "--fs-line": "#4b3fa833",
      "--fs-focus": "#4b3fa8",
      "--fs-shadow": "#25223a33",
      "--fs-radius": "1.6vh",
      "--fs-font": "\"Pixelify Sans\", system-ui, sans-serif",
      "--fs-title-font": "\"Pixelify Sans\", system-ui, sans-serif"
    },
    "night": {
      "--fs-bg": "#1c1a2a",
      "--fs-bg-2": "#302c4a",
      "--fs-panel": "#26233a",
      "--fs-text": "#eceaf6",
      "--fs-muted": "#aaa5c8",
      "--fs-accent": "#9d94e0",
      "--fs-accent-text": "#1c1a2a",
      "--fs-line": "#9d94e033",
      "--fs-focus": "#9d94e0",
      "--fs-shadow": "#00000066",
      "--fs-radius": "1.6vh",
      "--fs-font": "\"Pixelify Sans\", system-ui, sans-serif",
      "--fs-title-font": "\"Pixelify Sans\", system-ui, sans-serif"
    }
  },
  "options": [
    {
      "key": "buttons",
      "label": "Button colours",
      "choices": [
        {
          "value": "on",
          "label": "On"
        },
        {
          "value": "off",
          "label": "Off"
        }
      ]
    }
  ]
}
