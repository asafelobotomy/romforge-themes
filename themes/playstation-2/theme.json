      "--fs-title-font": "\"Exo 2\", system-ui, sans-serif"
    },
    "silver": {
      "--fs-bg": "#b8bcc4",
      "--fs-bg-2": "#d4d7dd",
      "--fs-panel": "#dfe2e7",
      "--fs-text": "#121722",
      "--fs-muted": "#444b5a",
